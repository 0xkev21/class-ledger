# ==============================================================================
# University Class Representative (EC) Treasury & Student Management
# Supabase Cloud Database Configuration
# ==============================================================================
# Instructions:
# 1. Create a free project at https://supabase.com
# 2. Go to SQL Editor in your Supabase Dashboard and run supabase/schema.sql
# 3. Go to Project Settings -> API Keys (or API)
#    - Copy your Project URL
#    - Copy your "Publishable API key" (sb_publishable_...) or legacy "anon" key
# 4. Copy this file to .env and fill in your values below:

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# New standard (recommended): Publishable Key
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Legacy key fallback (supported until 2027):
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
